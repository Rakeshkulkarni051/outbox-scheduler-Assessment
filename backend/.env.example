DATABASE_URL=""
REDIS_URL=""

# Ethereal Email (generate at https://ethereal.email/create)
ETHEREAL_USER=
ETHEREAL_PASS=

# Defaults, overridable per-campaign from the frontend
DEFAULT_HOURLY_LIMIT=200
MIN_DELAY_MS=2000

# Worker pool size — how many jobs a single worker process handles at once,
# per sender queue. Same knob the JD calls out as "configurable concurrency".
WORKER_CONCURRENCY=5

# Same Google OAuth Web client ID configured on the frontend (frontend's
# GOOGLE_CLIENT_ID). Used to verify the id_token the frontend sends on
# Authorization: Bearer <token> — NOT the client secret, this only needs
# the public client ID to check the token's audience.
GOOGLE_CLIENT_ID=


